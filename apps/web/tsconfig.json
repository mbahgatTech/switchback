{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    // Mirrors the root tsconfig: point at the package sources rather than the symlinks so
    // typecheck behaves the same here, at the root, and in vitest. No `baseUrl` — TS 6
    // deprecates it, and `paths` already resolve relative to this file.
    //
    // Every workspace package this app can reach is listed, including the three it only
    // reaches through `@switchback/api`. An unmapped one falls back to the node_modules
    // symlink, which in a git worktree points at the *other* checkout — so a change to
    // ingest and a change to db would be typechecked against different copies of the repo.
    "paths": {
      "@/*": ["./src/*"],
      "@switchback/core": ["../../packages/core/src/index.ts"],
      "@switchback/core/*": ["../../packages/core/src/*"],
      "@switchback/geo": ["../../packages/geo/src/index.ts"],
      "@switchback/geo/*": ["../../packages/geo/src/*"],
      "@switchback/db": ["../../packages/db/src/index.ts"],
      "@switchback/db/*": ["../../packages/db/src/*"],
      "@switchback/api": ["../../packages/api/src/index.ts"],
      "@switchback/api/*": ["../../packages/api/src/*"],
      "@switchback/ingest": ["../../packages/ingest/src/index.ts"],
      "@switchback/ingest/*": ["../../packages/ingest/src/*"],
      "@switchback/weather": ["../../packages/weather/src/index.ts"],
      "@switchback/weather/*": ["../../packages/weather/src/*"],
      "@switchback/busyness": ["../../packages/busyness/src/index.ts"],
      "@switchback/busyness/*": ["../../packages/busyness/src/*"],
      "@switchback/ui": ["../../packages/ui/src/index.ts"],
      "@switchback/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
