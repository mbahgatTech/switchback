# Switchback environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not — never put a real
# secret here. Everything below is either a local-development default or a placeholder.
#
# One file at the repo root serves every workspace: the db package loads it through
# `dotenv -e ../../.env`, Next.js reads it directly, and Expo reads the EXPO_PUBLIC_* keys.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local: `npm run db:up` starts Postgres 17 + PostGIS 3.5 on port 5433 (not 5432 — that
# is left free for whatever else you already have running).
DATABASE_URL="postgresql://switchback:switchback@localhost:5433/switchback?schema=public"

# Some managed Postgres routes normal queries through a connection pooler that cannot execute
# DDL. Migrations and `db push` need the direct endpoint. Locally there is no pooler, so both
# point at the same database — but both must be set, because the schema references each.
DIRECT_DATABASE_URL="postgresql://switchback:switchback@localhost:5433/switchback?schema=public"

# In production (Azure Database for PostgreSQL Flexible Server) both are the same endpoint,
# because the Burstable tier has no PgBouncer. Keep them distinct anyway — the split is what
# keeps DDL correct if the tier ever changes:
#   DATABASE_URL="postgresql://...@<server>.postgres.database.azure.com:5432/switchback?sslmode=verify-full"
#   DIRECT_DATABASE_URL="postgresql://...@<server>.postgres.database.azure.com:5432/switchback?sslmode=verify-full"

# The storage quota of the plan this database is on, in bytes. Ingest admission refuses new
# tiles once `pg_database_size` passes 85% of it, so the map stops filling instead of the
# database filling up and taking sign-in and activity recording down with it.
#
# It must match the plan, because nothing can measure it: Postgres reports what is used and
# nothing reports what is allowed. Unset, the guard is OFF and only the queue-depth ceiling
# applies — deliberately, because a guessed ceiling is worse than none. The guess this
# replaced was half a gigabyte, and production was already at 461 MB of it, which would have
# refused every ingest in the product on the day it deployed.
#
# A BARE INTEGER OF BYTES. No units, no separators, no arithmetic: `64GiB`, `32 GB`,
# `34,359,738,368` and `10_737_418_240` are all rejected, and a rejected value leaves the
# guard off. It says which in the log — "is unset" and "is not a positive integer of bytes"
# are two different lines, on purpose, because the first one printed at a variable that was
# in fact set is how five minutes of work becomes an afternoon.
#
# This is also the lever that bounds write amplification. Enrichment fans out at roughly 339
# jobs per z9 tile and drains slower than it fills, so the derived queue is watched and
# logged rather than capped — see `DERIVED_QUEUE_WARN_DEPTH` in
# `packages/ingest/src/backpressure.ts` for why capping it was a latch. Setting this is what
# gives that backlog a real ceiling.
#
#   Neon free              536870912     (0.5 GB)
#   Neon Launch            10737418240   (10 GB)
#   Azure Flexible (min)   34359738368   (32 GB)
#   Azure Flexible (64GiB) 68719476736   (64 GiB — what production is on)
DATABASE_SIZE_LIMIT_BYTES=""

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------

# `npx auth secret` generates one. Rotating it invalidates every session.
AUTH_SECRET=""
# Must match the deployment origin exactly, including scheme and port.
AUTH_URL="http://localhost:3000"
# Vercel terminates TLS at the edge; without this Auth.js builds http:// callback URLs.
AUTH_TRUST_HOST="true"

# --- Microsoft Entra ID (live) ---
# Azure Portal → Entra ID → App registrations → New registration.
# Supported account types: "Accounts in any organizational directory and personal
# Microsoft accounts" — that is what lets a personal @outlook.com sign in alongside work
# accounts. Redirect URI (Web): {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# "common" accepts work, school, and personal accounts. Use a tenant GUID to restrict to
# one organisation, or "consumers" for personal accounts only.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
# Only if the iOS app has its own app registration. One registration can carry both a Web
# and an iOS/macOS platform configuration — the usual setup — in which case leave this
# unset and the client id above is used to verify native identity tokens too.
AUTH_MICROSOFT_ENTRA_ID_MOBILE_ID=""

# --- Sign in with Apple (gated) ---
# Requires the $99/yr Apple Developer Program. Leave false until enrolled; the provider is
# fully implemented and simply not registered while this is false, so nothing breaks.
# Setup walkthrough: docs/auth-apple.md
AUTH_APPLE_ENABLED="false"
# Services ID (e.g. app.switchback.web) — the web flow's OAuth client_id.
AUTH_APPLE_ID=""
# App ID / bundle identifier (e.g. app.switchback.ios) — what native identity tokens carry
# in `aud`. Different string from AUTH_APPLE_ID above; swapping the two is the classic
# Apple setup mistake, and the only error Apple returns is `invalid_client`.
AUTH_APPLE_BUNDLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
# Contents of the .p8 private key, newlines as \n. The file itself is gitignored; do not
# commit it even so. Apple caps client secrets at 6 months, so we sign a fresh 1-hour one
# per sign-in instead of storing a long-lived secret — nothing to rotate. docs/auth-apple.md
AUTH_APPLE_PRIVATE_KEY=""

# --- iOS sign-in handshake ---
# The app signs in through a browser rather than talking to a provider directly, and the
# browser is sent back to the app over a custom URL scheme. Only "switchback://" is accepted
# unless this is true, which also allows Expo Go's "exp://192.168.x.x:8081" and localhost.
# Unset is correct: NODE_ENV !== "production" already allows them in development. Set this to
# "true" only on a preview deployment you are testing Expo Go against — never in production,
# where it would let anything on a LAN receive a sign-in code. See docs/mobile.md.
AUTH_MOBILE_ALLOW_DEV_SCHEMES=""

# ---------------------------------------------------------------------------
# Storage — Cloudflare R2 (S3-compatible)
# ---------------------------------------------------------------------------
#
# All five or none of them. Uploads work on a laptop with no Cloudflare account at all:
# packages/api/storage falls back to a driver that writes under .uploads/ and serves the
# objects back from /api/uploads. Filling in *some* of these is the one thing that is
# refused — a half-configured deploy would silently take that fallback and write user
# photographs to a serverless container that is discarded minutes later.
#
# So they are blank here rather than pre-filled with plausible-looking samples: a copied
# .env.example that names a bucket but no credentials fails env validation at import, which
# is a 500 on every page rather than a message about storage.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# e.g. "switchback"
R2_BUCKET=""
# Public bucket origin or a custom domain, used to build photo URLs. e.g. "https://cdn.example.com"
R2_PUBLIC_URL=""
# Optional. next.config.ts derives the same host from R2_PUBLIC_URL above, for the CSP and
# for next/image's remote allow-list, and only falls back to this. It exists because
# images.remotePatterns validates a hostname rather than a URL — leave it blank unless the
# public host differs from R2_PUBLIC_URL's.
NEXT_PUBLIC_R2_PUBLIC_HOST=""

# ---------------------------------------------------------------------------
# Upstream data sources
# ---------------------------------------------------------------------------

# Overpass mirror. Etiquette is a hard requirement: a descriptive User-Agent with a
# contact URL is what stops a public instance banning us outright.
#
# Do NOT put example.com (or any RFC 2606 placeholder) in the User-Agent. overpass-api.de
# rejects those at the front door with `406 Not Acceptable` — an Apache error page about
# content negotiation, which is a spectacularly misleading way to be told your contact
# address is fake. Every tile then fails for a reason nothing in the response names.
# `OverpassClient` refuses to construct with one for exactly that reason. Before going to
# production, point this at a URL or address that actually reaches you.
# Comma-separated, tried in order. Mirrors are not optional redundancy: overpass-api.de
# rate-limits by IP and will refuse a client outright, and the refusal arrives as a bare
# connection reset — no status, no body, and nothing a retry against the same host will
# ever get past. Leave this unset to use the built-in list. Note that several instances
# advertised on the OSM wiki serve a regional extract and answer a query outside their own
# country with a valid, empty, entirely misleading result; only add one you have tested.
OVERPASS_URL="https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
OVERPASS_USER_AGENT="Switchback/0.1 (+https://switchback.app)"

# AWS Terrain Tiles (Tilezen terrarium). Free, unlimited, no key.
TERRAIN_TILE_URL="https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"

# Open-Meteo. No key on the free tier (10k requests/day, non-commercial).
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1/air-quality"

# Basemap. Self-hosted Protomaps PMTiles on R2; falls back to the demo tiles in dev.
NEXT_PUBLIC_PMTILES_URL="https://cdn.example.com/basemap.pmtiles"

# Mapillary photo enrichment. Optional — enrichment skips it when unset.
MAPILLARY_TOKEN=""

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------

# Shared secret for /api/cron/drain, checked against the Authorization header so the
# endpoint is not an open trigger. Vercel Cron sends this automatically when set.
CRON_SECRET=""

# Which queue drives ingest.
#
#   postgres    (default) A viewport request drains its own tiles on the response's coattails,
#               and the daily cron drains the rest. What has always shipped.
#   servicebus  The request publishes one wake-up signal per queued tile to Azure Service Bus
#               and makes no Overpass call itself; the Function App worker drains. That is what
#               keeps the promise that at most two Overpass requests are ever in flight — the
#               worker's clamp is the only ceiling, because Vercel has stopped fetching.
#
# `ingest_jobs` is the queue of record on both sides: a message carries only a dedupeKey, so
# turning this back to `postgres` needs no migration and loses no work. Anything unrecognised
# reads as `postgres`, and `apps/web/src/env.ts` rejects a typo at startup rather than letting
# it degrade quietly.
INGEST_QUEUE_DRIVER="postgres"

# The three below are `ingest.bicep` outputs and none of them is a secret — that is the point.
# The publisher holds no key: Vercel signs an OIDC token per deployment, and a federated identity
# credential on the publisher managed identity is what makes Entra trust it. Turning any of these
# into a credential would need the federated credential's issuer *and* subject to match, which
# only a deployment of this project on this team can produce.
#
# All three are required once INGEST_QUEUE_DRIVER=servicebus; env validation refuses the set
# otherwise. `az deployment group show ... --query properties.outputs` prints them.

# `<namespace>.servicebus.windows.net` — the REST host, not the sb:// endpoint.
SERVICE_BUS_NAMESPACE=""

# Directory (tenant) id, and the publisher managed identity's *client* id (not its principal id).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""

# Only if the queue is not named `ingest-jobs`.
SERVICE_BUS_QUEUE=""

# ---------------------------------------------------------------------------
# Mobile (Expo) — EXPO_PUBLIC_* keys are embedded in the app binary. Public by design;
# never put a secret behind this prefix.
# ---------------------------------------------------------------------------

# Deliberately commented out, and it should stay that way in development.
#
# When this is set, apps/mobile/src/config.ts uses it verbatim; when it is unset, the app
# derives the API host from whatever machine served the Metro bundle. That derivation is
# the behaviour you want on a phone — `localhost` on an iPhone is the iPhone, so setting
# this to the value below is the one way to guarantee every request fails. Set it only for
# a release bundle, to the deployed origin.
#
# EXPO_PUBLIC_API_URL="https://switchback.app"
