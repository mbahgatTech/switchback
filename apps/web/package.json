{
  "name": "@switchback/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "next build",
    "//build:local": "Vercel injects env from the dashboard, so `build` must stay bare. Locally the same env lives in the repo-root .env, which Next does not look for from apps/web. SKIP_ENV_VALIDATION because `next build` sets NODE_ENV=production, which trips the production-only rules against a development .env — this build checks the bundle, not the secrets.",
    "build:local": "dotenv -e ../../.env -v SKIP_ENV_VALIDATION=1 -- next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "apple:secret": "dotenv -e ../../.env -- tsx scripts/apple-client-secret.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@switchback/api": "*",
    "@switchback/core": "*",
    "@switchback/db": "*",
    "@switchback/geo": "*",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "jose": "^6.2.4",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pmtiles": "^4.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "superjson": "^2.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.3.3"
  }
}
