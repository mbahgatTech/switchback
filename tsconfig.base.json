{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Declared here rather than left implicit. Up to TypeScript 5.7 an omitted `types` meant
    // "every package under node_modules/@types", so this was free; on 6.0 the same configs
    // stopped seeing `process`, `console`, and `import.meta.url` in packages/db, while the
    // root and web configs — which already named `node` — kept working. Naming it is also
    // the better default regardless: it makes the ambient surface a decision rather than a
    // function of whatever happens to be installed.
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "declaration": false,
    "sourceMap": true,

    // Workspace packages resolve to their sources rather than to the npm-workspace symlinks,
    // for the per-package configs, which had no `paths` of their own. This buys nothing in CI
    // — one checkout, so the symlink and the source are the same file — and changes no build:
    // the root, web and mobile configs each declare complete `paths` already and override this
    // wholesale, and mobile does not even extend this file. What it fixes is `npm run lint`
    // inside a git worktree. ESLint's `projectService` resolves a file through its *nearest*
    // tsconfig, so `packages/*/src/**` is read through `packages/*/tsconfig.json` rather than
    // the root project, and `node_modules/@switchback/*` points at the other checkout: without
    // this block, linting a worktree reports 21 errors in files the branch never touched.
    //
    // Mobile's own list is deliberately *incomplete* and must stay that way — `@switchback/db`
    // and the value exports of `@switchback/api` are omitted so that importing one is a
    // compile error rather than a Hermes crash on the phone. Nothing here reaches it.
    // Relative to this file, per TS 4.1+; no `baseUrl`, which TS 6 deprecates.
    "paths": {
      "@switchback/core": ["./packages/core/src/index.ts"],
      "@switchback/core/*": ["./packages/core/src/*"],
      "@switchback/geo": ["./packages/geo/src/index.ts"],
      "@switchback/geo/*": ["./packages/geo/src/*"],
      "@switchback/db": ["./packages/db/src/index.ts"],
      "@switchback/db/*": ["./packages/db/src/*"],
      "@switchback/ingest": ["./packages/ingest/src/index.ts"],
      "@switchback/ingest/*": ["./packages/ingest/src/*"],
      "@switchback/api": ["./packages/api/src/index.ts"],
      "@switchback/api/*": ["./packages/api/src/*"],
      "@switchback/ui": ["./packages/ui/src/index.ts"],
      "@switchback/ui/*": ["./packages/ui/src/*"],
      "@switchback/weather": ["./packages/weather/src/index.ts"],
      "@switchback/weather/*": ["./packages/weather/src/*"],
      "@switchback/busyness": ["./packages/busyness/src/index.ts"],
      "@switchback/busyness/*": ["./packages/busyness/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".expo"]
}
