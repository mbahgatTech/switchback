# Metro resolves against a hoisted node_modules tree and does not follow the nested layout
# some package managers produce. npm hoists by default, which is one reason this repo is on
# npm workspaces rather than pnpm — nothing to configure. (A `node-linker=hoisted` line used
# to sit here; it is a pnpm setting, npm ignores it, and npm 11 warns about it on every
# single command, including every step of CI.)
legacy-peer-deps=false
save-exact=false

# Node below the floor in package.json fails the install with a readable message rather than
# crashing Metro or tsc three commands later with something that looks like our bug.
engine-strict=true
