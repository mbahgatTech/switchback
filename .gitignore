# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.next/
# `NEXT_DIST_DIR` builds run alongside `next dev` so a smoke build or a cold-cache run does
# not evict the dev server's cache — see next.config.ts. Globbed rather than listed, because
# the name is chosen at the command line and the next one invented would otherwise arrive
# untracked-but-unignored.
.next-*/
out/
.expo/
*.tsbuildinfo

# native projects generated by `expo prebuild` — Continuous Native Generation regenerates
# them from app.config.ts, so a committed copy is a second source of truth that silently
# wins over the config it was generated from
apps/mobile/ios/
apps/mobile/android/

# env — never commit secrets
.env
.env.local
.env.*.local
!.env.example
*.p8
*.mobileprovision
*.p12

# test output
coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/

# prisma
packages/db/prisma/migrations/dev.db*

# local data cache (terrain tiles, overpass responses)
.cache/
tmp/
*.pmtiles

# photographs written by the local storage driver, which stands in for R2 until Cloudflare
# credentials exist — user content, regenerated by uploading again, never a source of truth
.uploads/

# design review screenshots — a critique loop against the running app, regenerated on
# demand and stale the moment the page changes, so a committed copy would only mislead
.design/

# design-tool hook cache — derived from the source it watches, rebuilt on demand
.impeccable/

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# logs
*.log
npm-debug.log*
yarn-error.log*

# vercel
.vercel
