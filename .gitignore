# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.next/
# `NEXT_DIST_DIR` builds run alongside `next dev` so a smoke build or a cold-cache run does
# not evict the dev server's cache — see next.config.ts. Globbed rather than listed, because
# the name is chosen at the command line and the next one invented would otherwise arrive
# untracked-but-unignored.
.next-*/
out/
.expo/
*.tsbuildinfo

# native projects generated by `expo prebuild` — Continuous Native Generation regenerates
# them from app.config.ts, so a committed copy is a second source of truth that silently
# wins over the config it was generated from
apps/mobile/ios/
apps/mobile/android/

# env — never commit secrets
.env
.env.local
.env.*.local
!.env.example
*.p8
*.mobileprovision
*.p12

# Azure deployment parameters, belt and braces.
#
# `infra/azure/main.bicepparam` holds only non-secret values and is committed; the admin
# password reaches the deployment through the environment instead. But the shapes below are
# what someone reaches for when they are in a hurry — a hand-written ARM parameters file or a
# "just for me" bicepparam — and either one would carry the password that is the *only* thing
# between the open internet and every user's email and GPS history. Ignored in advance, so
# the mistake is uncommittable rather than merely discouraged.
#
# The bicepparam half is written as ignore-everything-then-allow-one rather than as a list of
# guessed names, because a deny-list here was measurably too narrow: an earlier revision
# ignored only `*.local.bicepparam`, while Bicep's own convention is `<name>.bicepparam`
# beside the template — so `prod.bicepparam`, `dev.bicepparam` and `secrets.bicepparam`, which
# are the *likelier* names once `main.bicepparam` is taken, were all committable. The negation
# inverts the burden: a new parameter file is ignored until someone deliberately adds it here.
#
# `parameters.json` and `params.json` are named in full as well as by suffix. `*.parameters.json`
# does not match a bare `parameters.json` — the pattern needs a literal `.` before `parameters`,
# and `*` matching the empty string leaves nothing to supply it.
infra/azure/*.bicepparam
!infra/azure/main.bicepparam
# Non-secret like main.bicepparam: the Postgres connection string and the Mapillary token are
# `@secure()` in ingest.bicep and read from the environment, never written here.
!infra/azure/ingest.bicepparam
infra/azure/*.parameters.json
infra/azure/*.params.json
infra/azure/parameters.json
infra/azure/params.json

# test output
coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/
# The Playwright MCP server writes screenshots here when it drives the site.
.playwright-mcp/

# prisma
packages/db/prisma/migrations/dev.db*

# local data cache (terrain tiles, overpass responses)
.cache/
tmp/
*.pmtiles

# photographs written by the local storage driver, which stands in for R2 until Cloudflare
# credentials exist — user content, regenerated by uploading again, never a source of truth
.uploads/

# design review screenshots — a critique loop against the running app, regenerated on
# demand and stale the moment the page changes, so a committed copy would only mislead
.design/

# design-tool hook cache — derived from the source it watches, rebuilt on demand
.impeccable/

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# logs
*.log
npm-debug.log*
yarn-error.log*

# vercel
# Holds project.json — the project and org ids the CLI links this checkout to. Not a
# credential, but machine-local: a second clone gets its own on `vercel link`.
.vercel

# claude code
# Agent worktrees land here, inside the repo root. Each is a whole extra copy of the monorepo.
.claude

# Harness Work Orders. These are a build record for the agents that produce a change — status
# field, iteration log, cap budget — not documentation of the system, and the repository's docs
# are reference for a reader who was not there. The decisions survive in the code and the PR.
.plans
